# Kwop (server only, secret)
KWOP_API=
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
# Google Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-2.5-flash
# Public address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 once Google sign-in is configured in Supabase
NEXT_PUBLIC_GOOGLE_ENABLED=0
# Salt for hashing IPs (rate limits)
IP_SALT=
